# Disposable root package/service test fixture; not an application runtime or published image.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       bash ca-certificates cron curl dpkg-dev git gpg jq openssh-server python3 shellcheck sshpass sudo wget zsh \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
CMD ["bash", "-euc", "dpkg -i \"$PDS_TEST_PACKAGE\"; python3 -B -m unittest discover -s tests -p '*test*.py' -v"]
